#!/usr/bin/env bash
# Launch Pacman for Omarchy as a standalone Quickshell process (ADR-0001).
set -euo pipefail

if ! command -v qs >/dev/null 2>&1; then
  echo "pacman: 'qs' (Quickshell) was not found on PATH." >&2
  echo "Install it with: sudo pacman -S quickshell" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# The repo root is the Quickshell config root (root shell.qml, ADR-0001
# amendment): it instantiates app/Main.qml, and app/ can then reach lib/ and
# assets/ as real sibling directories with no symlinks.
exec qs -p "$ROOT" "$@"
